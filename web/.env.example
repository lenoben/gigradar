# Route Upwork requests through a residential/rotating proxy. REQUIRED on any
# datacenter/VPS/cloud host — Upwork's Cloudflare 403s those IPs (and a single
# residential IP gets rate-limited under load). e.g. Webshare. Omit for local
# dev on a residential connection.
# UPWORK_PROXY=http://user:pass@host:port

# Optional: token-fetch retries (default 5). Lower = fail fast behind a blocked IP.
# UPWORK_MAX_RETRIES=5

# Resend transactional email (https://resend.com).
# Without RESEND_API_KEY, signups are STILL stored in data/subscriptions.jsonl
# but no confirmation or job-alert email is sent (the send is a no-op).
RESEND_API_KEY=

# From address. Must be a verified Resend domain, or use the shared sandbox
# sender below (onboarding@resend.dev) for testing.
RESEND_FROM="Upwork Jobs <onboarding@resend.dev>"
