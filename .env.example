# gigradar secrets — copy to .env (gitignored). Real environment variables win over this file.

# Telegram alerts (used when [notify].channels includes "telegram" in gigradar.toml):
# create a bot with @BotFather, send it any message, then get your chat id (e.g. via @userinfobot).
# Test: python -m gigradar.telegram --test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional residential proxy, used only when [token].use_proxy = true in gigradar.toml.
UPWORK_PROXY=
