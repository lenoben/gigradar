# gigradar secrets — copy to .env (gitignored). Real environment variables win over this file.

# Telegram alerts: create a bot with @BotFather, then get your chat id (e.g. via @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional residential proxy, used only when [token].use_proxy = true in gigradar.toml.
UPWORK_PROXY=
